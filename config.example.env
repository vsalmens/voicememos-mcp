# voicememos-mcp configuration.
# Copy to ~/.config/voicememos-mcp/config.env (install.sh does this) and edit there.
# This file holds no secrets. SONIOX_API_KEY and ROAM_API_TOKEN live in the macOS Keychain
# (service "voicememos-mcp") or in the environment.

# Where transcripts are written (Markdown + JSON, one pair per memo). Keep this outside Documents,
# Desktop, Downloads and iCloud Drive: the MCP server cannot read those (see README). To browse the
# transcripts from Documents, link them there: ln -s "<this folder>" ~/Documents/voice-memos
VOICEMEMOS_OUTPUT_DIR="~/Library/Application Support/voicememos-mcp/transcripts"

# Internal state, queue, jobs and logs.
VOICEMEMOS_DATA_DIR="~/Library/Application Support/voicememos-mcp"

# Voice Memos folder. Empty = detect automatically.
VOICEMEMOS_RECORDINGS_DIR=""

# --- Speech recognition (Soniox) ---
# Language hints, comma separated ISO 639-1 codes. Mixed-language speech is supported.
VOICEMEMOS_LANGUAGES="en"
# Names and terms the engine should know (comma separated). Helps with rare words.
VOICEMEMOS_CONTEXT_TERMS=""
# Free-text description of the recordings, e.g. "Personal notes, often recorded in a car."
VOICEMEMOS_CONTEXT_TEXT=""
SONIOX_BASE_URL="https://api.soniox.com"
SONIOX_MODEL="stt-async-v5"

# --- Speakers ---
# Separate speakers (Soniox diarization). Memos with one speaker are unchanged; with several,
# each turn starts with **S1:**, **S2:** ...
VOICEMEMOS_DIARIZATION="1"
# Optional: recognise your own voice with a local voiceprint (see README, "Voiceprint").
# Name shown for you once you have enrolled; empty = not used.
VOICEMEMOS_VOICEPRINT_NAME=""
VOICEMEMOS_VOICEPRINT_MODEL="3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced"

# --- Uncertainty marking ---
# Words below this confidence are marked "word (?)". Calibrate on your own recordings.
VOICEMEMOS_CONF_THRESHOLD="0.70"
# This many consecutive uncertain words are grouped as "[?: w1 w2 w3 w4]".
VOICEMEMOS_RUN_MIN="4"
# A pause longer than this (ms) starts a new paragraph.
VOICEMEMOS_PAUSE_MS="2500"
# Time stamp ([mm:ss] or [h:mm:ss]) at the start of a paragraph when at least this many seconds
# have passed since the previous one. 0 = no time stamps.
VOICEMEMOS_TIMESTAMP_EVERY_S="60"

# --- Which memos ---
# Transcribe new memos automatically when the worker runs.
VOICEMEMOS_AUTO_TRANSCRIBE="1"
# Only transcribe memos recorded on or after this date automatically (YYYY-MM-DD). Empty = all.
VOICEMEMOS_SINCE=""
# Hide memos completely (from transcription and from every tool):
# folder names in Voice Memos (comma separated, case-insensitive) ...
VOICEMEMOS_EXCLUDE_FOLDERS=""
# ... or titles matching this regular expression (case-insensitive).
VOICEMEMOS_EXCLUDE_TITLE_REGEX=""

# --- Second reader (optional) ---
# An independent Gemini transcription aligned with the primary one; disagreements show as {a|b}.
# "gemini" = read every new memo automatically. "gemini-low" = only memos whose primary
# transcript has low certainty (15 % or more of words marked). Empty = only on request (second-read command or
# the voicememos_second_read tool). Needs GEMINI_API_KEY in the Keychain or environment.
VOICEMEMOS_SECOND_READER=""
VOICEMEMOS_SECOND_READER_MODEL="gemini-4-argon"
# Longer memos are skipped by the second reader.
VOICEMEMOS_SECOND_READER_MAX_MIN="60"

# --- Spoken markers ---
# Sentences that start with one of these words are collected as markers.
# Format: spoken word=label, comma separated; a trailing * accepts inflected forms.
VOICEMEMOS_MARKERS="idea=Idea,task=Task,remember=Remember,question=Question"
# Optional wake word required right before the marker word ("Dictate idea: ..."),
# and an end word that closes a marker longer than one sentence ("Dictate end").
# Add the wake word to VOICEMEMOS_CONTEXT_TERMS too.
VOICEMEMOS_MARKER_WAKE=""
VOICEMEMOS_MARKER_END=""

# --- Roam Research (optional) ---
# Append new transcripts to the daily note of the recording date (append-only token in Keychain).
VOICEMEMOS_ROAM_ENABLED="0"
ROAM_GRAPH=""
# Placeholders: {time} {date} {duration} {stats} {title}
VOICEMEMOS_ROAM_HEADING="🎙️ Voice memo {time} ({duration}) #voicememo {stats}{title}"
# Also append memos transcribed on request (backfill). Off by default to avoid flooding old daily notes.
VOICEMEMOS_ROAM_BACKFILL="0"

# --- Worker ---
# launchd (recommended): a background job does the transcription and needs Full Disk Access.
# inprocess: the MCP server transcribes itself (then the MCP host needs Full Disk Access).
VOICEMEMOS_WORKER="launchd"
VOICEMEMOS_LAUNCHD_LABEL="local.voicememos-mcp.sync"
